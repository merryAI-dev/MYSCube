# Server-only configuration. Values below are placeholders, not provisioned resources.
WORKBENCH_PROJECT_ID=myscube-axr-data
PRODUCTION_PROJECT_ID=existing-business-project
WORKBENCH_MODEL_PROJECT_ID=myscube-axr-model
PRODUCTION_MODEL_PROJECT_ID=replace-with-current-model-project
WORKBENCH_AUTH_PROJECT_ID=replace-with-identity-project
WORKBENCH_TENANT_ID=mysc
WORKBENCH_APP_ORIGIN=https://replace-workbench-host.example
WORKBENCH_AI_ENABLED=false
WORKBENCH_READS_ENABLED=true
WORKBENCH_GIT_REPOSITORY=replace-owner/private-generated-pages
WORKBENCH_GIT_CREDENTIAL_MODE=github-app
# Inject App ID, installation ID and private key from a dedicated server secret.
# No production settlement credential belongs in this process.
WORKBENCH_COPY_ENABLED=false
WORKBENCH_COPY_SOURCE_PROJECT_ID=existing-business-project
WORKBENCH_COPY_DATASET_GRANTS={}
WORKBENCH_HTTP_LOG_IMPORT_ENABLED=false
# Optional native Vercel project ID for offline log exports; no drain is provisioned.
# WORKBENCH_HTTP_LOG_SOURCE_PROJECT_ID=replace-with-approved-vercel-project
WORKBENCH_IMPORT_ENABLED=false
WORKBENCH_SHEETS_COPY_ENABLED=false
WORKBENCH_REMOTE_RUNTIME_ENABLED=false
# Only on an approved dedicated host with the fixed renderer image and external reaper installed:
# WORKBENCH_REMOTE_RUNTIME_DRIVER=docker-host
# Cloud Run app candidates cannot host the Docker broker.
