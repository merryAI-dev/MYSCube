{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "functions": {
    "api/bff.js": {
      "maxDuration": 300,
      "regions": [
        "iad1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/internal/workers/work-queue/run",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/internal/workers/outbox/run",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/internal/workers/payroll/run",
      "schedule": "45 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "inner-platform.vercel.app"
        }
      ],
      "destination": "https://myscube.myscguard.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "inner-platform-h799435np-merryai-devs-projects.vercel.app"
        }
      ],
      "destination": "https://myscube.myscguard.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "inner-platform-dsk6wdc3e-merryai-devs-projects.vercel.app"
        }
      ],
      "destination": "https://myscube.myscguard.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "inner-platform-gq6813nqh-merryai-devs-projects.vercel.app"
        }
      ],
      "destination": "https://myscube.myscguard.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "inner-platform-k2x121b33-merryai-devs-projects.vercel.app"
        }
      ],
      "destination": "https://myscube.myscguard.app/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/__/auth/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/__/firebase/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/((?!(?:__/auth|__/firebase)/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://inner-platform-live-20260316.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://inner-platform-live-20260316.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/v1",
      "destination": "/api/bff?__path=/api/v1"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/bff?__path=/api/v1/:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/bff?__path=/mcp"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api/bff?__path=/.well-known/:path*"
    },
    {
      "source": "/api/internal/workers/work-queue/run",
      "destination": "/api/bff?__path=/api/internal/workers/work-queue/run"
    },
    {
      "source": "/api/internal/workers/outbox/run",
      "destination": "/api/bff?__path=/api/internal/workers/outbox/run"
    },
    {
      "source": "/api/internal/workers/payroll/run",
      "destination": "/api/bff?__path=/api/internal/workers/payroll/run"
    },
    {
      "source": "/api/internal/workers/client-errors/run",
      "destination": "/api/bff?__path=/api/internal/workers/client-errors/run"
    },
    {
      "source": "/api/internal/workers/cashflow-weekly-digest/run",
      "destination": "/api/bff?__path=/api/internal/workers/cashflow-weekly-digest/run"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/static-asset-not-found?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
