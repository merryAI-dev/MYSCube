rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════
    // 기본 인증 헬퍼
    // ══════════════════════════════════════════════════════════════

    // 1차: Firebase 로그인 + @mysc.co.kr 이메일 도메인 확인
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@mysc\\.co\\.kr$');
    }

    // ══════════════════════════════════════════════════════════════
    // 테넌트 격리 헬퍼 (orgs/{orgId}/members/{uid} 멤버십 확인)
    // ══════════════════════════════════════════════════════════════

    // status가 없던 구형 멤버 문서는 마이그레이션 전까지 활성으로 취급한다.
    function isActiveMemberDocument(member) {
      return !member.keys().hasAny(['status'])
        || member.status == 'ACTIVE';
    }

    // 요청 사용자가 해당 orgId의 활성 멤버인지 확인
    function isMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid))
        && isActiveMemberDocument(
          get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data
        );
    }

    // 멤버 문서에서 역할 조회
    function getMemberRole(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    // ══════════════════════════════════════════════════════════════
    // 역할 기반 접근 제어 헬퍼
    // ══════════════════════════════════════════════════════════════

    // 읽기: org 멤버면 허용 (viewer 포함)
    function canRead(orgId) {
      return isMember(orgId);
    }

    // 쓰기: viewer 제외 모든 역할 허용 (admin, finance, pm)
    function canWrite(orgId) {
      return isMember(orgId)
        && getMemberRole(orgId) in ['admin', 'finance', 'pm'];
    }

    // 어드민 전용
    function isAdmin(orgId) {
      return isMember(orgId)
        && getMemberRole(orgId) in ['admin'];
    }

    // 감사/재무 접근 (audit_logs 읽기용)
    function canReadAuditLogs(orgId) {
      return isMember(orgId)
        && getMemberRole(orgId) in ['admin', 'finance'];
    }

    function isSafeSelfMemberUpdate(orgId, memberId) {
      return isSignedIn()
        && memberId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && resource.data.tenantId == orgId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tenantId == orgId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'avatarUrl', 'updatedAt', 'lastLoginAt',
          'defaultWorkspace', 'lastWorkspace'
        ]);
    }

    // BFF 전용 PII 컬렉션: 클라이언트 SDK 직접 접근 금지.
    // BFF(Admin SDK)는 rules를 우회하므로 검증, 감사, idempotency를 서버에서 강제한다.
    function isBffOnlyCollection(collection) {
      return collection in ['contacts', 'business_card_imports', 'contact_events', 'persons'];
    }

    // 일반 org 멤버 catchall에서 제외할 컬렉션.
    // 각 컬렉션의 상단 override 규칙만 적용되도록 막는다.
    function isCatchallExcludedCollection(collection) {
      return isBffOnlyCollection(collection)
        || collection in ['members']
        || collection in ['projectRequestDrafts']
        || collection in ['privateEditDrafts']
        || collection in ['careerProfiles']
        || collection in ['project_requests']
        || collection in ['projectRequests']
        || collection in ['projectCodeClaims']
        || collection in ['cashflowEditLocks']
        || collection in ['cashflow_edit_locks']
        || collection in ['editLeases']
        || collection in ['cashflow_sheet_mirrors']
        || collection in ['cashflow_sheet_snapshots']
        || collection in ['cashflow_sheet_snapshot_months']
        || collection in ['cashflow_sheet_snapshot_years']
        || collection in ['cashflow_sheet_week_values']
        || collection in ['cashflow_sheet_year_totals']
        || collection in ['cashflow_sheet_refresh_runs']
        || collection in ['cashflow_sheet_stage_runs']
        || collection in ['cashflow_sheet_stage_months']
        || collection in ['cashflow_sheet_stage_years']
        || collection in ['cashflow_change_candidates']
        || collection in ['cashflow_month_close_requests']
        || collection in ['cashflow_month_close_request_months']
        || collection in ['cashflow_month_close_request_audits']
        || collection in ['cashflow_cumulative_close_heads']
        || collection in ['monthly_closes']
        || collection in ['monthly_close_versions']
        || collection in ['weekly_api_idempotency']
        || collection in ['weekly_api_audit_events']
        || collection in ['weekly_api_audit_exports']
        || collection in ['idempotency_keys'];
    }

    function isCatchallExcludedPath(collection, document) {
      return isCatchallExcludedCollection(collection)
        || (collection == 'settings' && document in ['project-departments', 'organizations', 'person-grades']);
    }

    // Canonical finance/project state is written only by the BFF/JVM Admin SDK.
    // Reads remain available to org members through the root catchall below.
    function isCanonicalServerWriteCollection(collection) {
      return collection in [
        'projects',
        'project_requests',
        'projectRequests',
        'cashflow_weeks',
        'cashflow_settlement_statuses',
        'cashflow_weekly_update_completions',
        'monthly_closes',
        'weekly_submission_status',
        'transactions',
        'comments',
        'evidences',
        'budget_evidence_maps',
        'participation_roster_push_status'
      ];
    }

    function isCanonicalServerWriteSubcollection(collection, subcollection) {
      return collection == 'projects' && subcollection == 'bank_statements';
    }

    // ══════════════════════════════════════════════════════════════
    // 최상위 tenants는 클라이언트 목록 쿼리 권한을 안정적으로 검증할 수 없으므로 사용하지 않는다.
    // 조직DB는 orgs/{orgId}/tenant_registry에서 조직 admin 권한으로 관리한다.
    // ══════════════════════════════════════════════════════════════

    match /tenants/{tenantId} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // orgs/{orgId}/** 규칙
    // 특정 컬렉션 override → 일반 규칙 순서로 적용
    // ══════════════════════════════════════════════════════════════

    // ── 구성원(members) ──
    // 테넌트 격리의 핵심: 이 문서가 존재해야 isMember() 통과
    match /orgs/{orgId}/members/{memberId} {
      allow get: if (isSignedIn() && memberId == request.auth.uid) || canRead(orgId);
      allow list: if canRead(orgId);

      // 구성원 생성은 Auth Governance BFF(Admin SDK)에서만 수행한다.
      allow create: if false;

      // 자기 문서 업데이트: lastLoginAt/avatarUrl 등 갱신 허용, role 변경 불가
      allow update: if isSafeSelfMemberUpdate(orgId, memberId);

      // Admin: 역할 변경·삭제·타인 문서 수정
      allow update, delete: if isAdmin(orgId);
    }

    // ── 조직DB: 현재 조직 admin만 조직 registry를 관리 ──
    match /orgs/{orgId}/tenant_registry/{tenantId} {
      allow read: if isAdmin(orgId);

      allow create: if isAdmin(orgId)
        && request.resource.data.id == tenantId
        && request.resource.data.adminOrgId == orgId;

      allow update: if isAdmin(orgId)
        && request.resource.data.adminOrgId == resource.data.adminOrgId;

      allow delete: if isAdmin(orgId)
        && resource.data.protected != true;
    }

    // ── 감사 로그: 클라이언트 쓰기 금지, 특정 역할만 읽기 ──
    // 생성은 BFF 서버(Admin SDK)에서만 수행 → 규칙 우회됨
    match /orgs/{orgId}/audit_logs/{logId} {
      allow read: if canReadAuditLogs(orgId);
      allow write: if false;
    }

    // ── 알림: 본인 알림만 읽기/읽음 처리 ──
    // 생성은 BFF 서버에서만 수행
    // recipientId == request.auth.uid 조건은 쿼리 필터와 함께 동작
    match /orgs/{orgId}/notifications/{notifId} {
      allow read: if canRead(orgId) && resource.data.recipientId == request.auth.uid;
      allow update: if canRead(orgId) && resource.data.recipientId == request.auth.uid;
      allow create, delete: if false;
    }

    // ── 명함 DB/연락처: BFF API로만 접근 ──
    match /orgs/{orgId}/contacts/{contactId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/business_card_imports/{importId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/contact_events/{eventId} {
      allow read, write: if false;
    }

    // 은퇴한 컬렉션. 포털 마이페이지는 인력 명부(persons)를 읽는다.
    // 지우는 대신 닫아 둔다 - 제외 목록에서 빼면 catchall 의 canRead 가 걸려 조직 전체가 읽게 된다.
    match /orgs/{orgId}/careerProfiles/{uid} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/persons/{personId} {
      allow read, write: if false;
    }

    // ── 편집 lease: BFF API로만 접근 ──
    match /orgs/{orgId}/editLeases/{leaseId} {
      allow read, write: if false;
    }

    // ── 멱등 replay 결과: BFF API로만 접근 ──
    match /orgs/{orgId}/idempotency_keys/{keyId} {
      allow read, write: if false;
    }

    // ── 주간 API 멱등/감사 레코드: JVM/BFF API로만 접근 ──
    match /orgs/{orgId}/weekly_api_idempotency/{keyId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/weekly_api_audit_events/{eventId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/weekly_api_audit_exports/{exportId} {
      allow read, write: if false;
    }

    // ── 캐시플로 시트 고정본/검토 run: BFF API로만 접근 ──
    match /orgs/{orgId}/cashflow_sheet_mirrors/{mirrorId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_sheet_snapshots/{snapshotId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_sheet_snapshot_months/{monthId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_sheet_snapshot_years/{yearId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_sheet_week_values/{monthId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_sheet_year_totals/{yearId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_sheet_refresh_runs/{runId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_sheet_stage_runs/{runId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_sheet_stage_months/{monthId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_sheet_stage_years/{yearId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_change_candidates/{candidateId} {
      allow read, write: if false;
    }

    // ── 월 결산 승인 요청: BFF API로만 접근 ──
    match /orgs/{orgId}/cashflow_month_close_requests/{requestId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_month_close_request_months/{monthId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_month_close_request_audits/{auditId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_cumulative_close_heads/{projectId} {
      allow read, write: if false;
    }

    // ── 프로젝트 변경 알림: admin/finance만 쓰기 ──
    match /orgs/{orgId}/project_change_alerts/{alertId} {
      allow read: if canRead(orgId);
      allow write: if isMember(orgId)
        && getMemberRole(orgId) in ['admin', 'finance'];
    }

    // ── 관리자 설정: 프로젝트 선택값 ──
    match /orgs/{orgId}/settings/project-departments {
      allow read: if canRead(orgId);
      allow write: if isAdmin(orgId);
    }

    // ── 관리자 설정: 직급 목록 ──
    match /orgs/{orgId}/settings/person-grades {
      allow read: if canRead(orgId);
      allow write: if isAdmin(orgId);
    }

    // ── 관리자 설정: 조직(소속) 목록 ──
    // 인력 명부의 소속·팀과 프로젝트 담당조직이 함께 뻗어 나오는 뿌리다.
    // 조직 개편은 배포와 무관하게 일어나므로 관리자가 직접 고친다.
    match /orgs/{orgId}/settings/organizations {
      allow read: if canRead(orgId);
      allow write: if isAdmin(orgId);
    }

    // ── 프로젝트 등록/수정 임시저장: BFF API로만 접근 ──
    match /orgs/{orgId}/projectRequestDrafts/{draftId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/privateEditDrafts/{draftId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/project_requests/{requestId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/projectRequests/{requestId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/projectCodeClaims/{claimId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/monthly_closes/{closeId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/monthly_close_versions/{versionId} {
      allow read, write: if false;
    }

    // ── 구형 캐시플로 직접 잠금: BFF lease를 우회하지 못하도록 차단 ──
    match /orgs/{orgId}/cashflowEditLocks/{lockId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/cashflow_edit_locks/{lockId} {
      allow read, write: if false;
    }

    // ── 은행거래 원본: BFF/JVM API로만 쓰기 ──
    match /orgs/{orgId}/projects/{projectId}/bank_statements/{documentId} {
      allow read: if canRead(orgId);
      allow write: if false;
    }

    // ── 일반 규칙: 최상위 문서 ──
    match /orgs/{orgId}/{collection}/{document} {
      allow read: if !isCatchallExcludedPath(collection, document) && canRead(orgId);
      allow write: if !isCatchallExcludedPath(collection, document)
        && !isCanonicalServerWriteCollection(collection)
        && canWrite(orgId);
    }

    // 프로젝트 하위 컬렉션은 아직 일부 화면이 클라이언트 SDK로 저장한다.
    // 서버 경로 전환이 끝난 하위 컬렉션부터 별도 규칙으로 차단한다.
    match /orgs/{orgId}/{collection}/{document}/{subcollection}/{nested=**} {
      allow read: if !isCatchallExcludedCollection(collection) && canRead(orgId);
      allow write: if !isCatchallExcludedCollection(collection)
        && !isCanonicalServerWriteSubcollection(collection, subcollection)
        && canWrite(orgId);
    }
  }
}
